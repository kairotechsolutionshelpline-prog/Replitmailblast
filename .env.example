# ─── REQUIRED ───────────────────────────────────────────────────────────────

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender email on Resend (fallback if no senders in DB)
SENDER_EMAIL=hello@redalertsol.com

# Admin login email
ADMIN_EMAIL=admin@yourdomain.com

# Bcrypt hash of your admin password
# Generate with: node -e "const b=require('bcryptjs'); b.hash('YOUR_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$replacethiswithyourrealbcrypthash

# ─── RECOMMENDED ────────────────────────────────────────────────────────────

# Random 32+ character secret for session security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_32_char_string

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Optional: URL of your hosted logo image (shown in emails)
LOGO_URL=

# Optional: Path to store SQLite DB (default: ./data)
DATA_DIR=

# Set to 'production' on Railway
NODE_ENV=production

# Your app's public base URL (used for unsubscribe links)
# e.g. https://your-app.up.railway.app
APP_BASE_URL=https://your-app.up.railway.app
